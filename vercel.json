{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/student/(.*)",
      "dest": "frontend/student/$1"
    },
    {
      "src": "/faculty/(.*)",
      "dest": "frontend/faculty/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/login",
      "dest": "frontend/login.html"
    },
    {
      "src": "/achievements",
      "dest": "frontend/student/achievements.html"
    },
    {
      "src": "/problems",
      "dest": "frontend/student/problems.html"
    },
    {
      "src": "/progress",
      "dest": "frontend/student/progress.html"
    },
    {
      "src": "/lab",
      "dest": "frontend/student/lab.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
