{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/student/dashboard",
      "dest": "/frontend/student/dashboard.html"
    },
    {
      "src": "/student/lab",
      "dest": "/frontend/student/lab.html"
    },
    {
      "src": "/student/problems",
      "dest": "/frontend/student/problems.html"
    },
    {
      "src": "/student/progress",
      "dest": "/frontend/student/progress.html"
    },
    {
      "src": "/student/achievements",
      "dest": "/frontend/student/achievements.html"
    },
    {
      "src": "/faculty/dashboard",
      "dest": "/frontend/faculty/dashboard.html"
    },
    {
      "src": "/faculty/manual",
      "dest": "/frontend/faculty/manual.html"
    },
    {
      "src": "/student/(.*)",
      "dest": "/frontend/student/$1"
    },
    {
      "src": "/faculty/(.*)",
      "dest": "/frontend/faculty/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
