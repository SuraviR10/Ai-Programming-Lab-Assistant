# SMART LAB Environment Configuration Example
# Copy this file to .env or backend/.env and populate with your credentials

# Groq API Key (Required for AI Error Explanation and Adaptive Practice)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: PostgreSQL Database URL (e.g. Supabase connection string)
# Leave empty or unset to automatically use local zero-configuration SQLite (data/ailab.db)
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Server Port (Defaults to 8000)
PORT=8000
