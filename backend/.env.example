# ===================================================================
# SMART LAB Environment Configuration
# Copy this file to .env or backend/.env and populate with your keys
# ===================================================================

# 1. Groq Cloud API Key (Required for AI Error Diagnostics & Practice Challenges)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Database Configuration (Supabase PostgreSQL or Local SQLite)
# - To use Supabase: Set DATABASE_URL with your Supabase PostgreSQL connection string.
#   Format A (Direct / Session Pooler - Port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
#   Format B (Transaction Pooler - Port 6543, recommended for serverless):
#   DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# - To use Local SQLite: Leave DATABASE_URL commented out or empty.
#   SMART LAB will automatically initialize and use local backend/data/ailab.db with zero configuration.
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# 3. Server Port (Defaults to 8000)
PORT=8000

